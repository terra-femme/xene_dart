# ── Environment identifier ───────────────────────────
# Values: development | staging | production
# Controls log level (ALL in dev, INFO in staging/prod)
XENE_ENV=development

# ── Database (Supabase) ──────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── Distributed Cache (DragonflyDB) ──────────────────
# DragonflyDB URL for distributed request coalescing across replicas.
# Local dev (docker-compose): redis://localhost:6379
# Production (Upstash): redis://default:<password>@<host>.<region>.upstash.io:6379
DRAGONFLY_URL=redis://localhost:6379

# ── SoundCloud ───────────────────────────────────────
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=http://localhost:8080/auth/soundcloud/callback

# ── Twitch ───────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8080/auth/twitch/callback

# ── AI & LLMs ────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# ── Metadata Services ────────────────────────────────
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_REQUEST_TOKEN_URL=https://api.discogs.com/oauth/request_token
DISCOGS_AUTHORIZE_URL=https://www.discogs.com/oauth/authorize
DISCOGS_ACCESS_TOKEN_URL=https://api.discogs.com/oauth/access_token
DISCOGS_REDIRECT_URI=http://localhost:8080/auth/discogs/callback

# ── YouTube ──────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Token encryption (generate with: dart run gen_key.dart) ──
TOKEN_ENCRYPTION_KEY=

# ── Admin ────────────────────────────────────────────
# Generate a unique value per environment — never share between dev/staging/prod
ADMIN_SECRET=

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty in dev for permissive mode.
# Example for prod: https://xene.app
# Example for staging: https://staging.xene.app
ALLOWED_ORIGINS=

# ── Trusted reverse-proxy hops ───────────────────────
# How many proxies sit in front of this server and append to X-Forwarded-For.
# PROVIDER-SPECIFIC — set per host, don't hardcode:
#   0 = local dev / no proxy (X-Forwarded-For is NOT trusted — safe default)
#   1 = typical Azure App Service or a single GCP HTTPS load balancer
#   +1 extra if you add Cloudflare in front of your origin proxy
# Controls how extractClientIp() picks the real client IP for IP-keyed rate
# limits. Too low → spoofable limits; too high → everyone shares one bucket.
# Verify against your real deployment before trusting it.
TRUSTED_PROXY_HOPS=0
