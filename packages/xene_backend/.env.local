# ══════════════════════════════════════════════════════════════════════════════
# Local Development Environment Override (.env.local)
# ══════════════════════════════════════════════════════════════════════════════
# Loaded by run_dev.ps1 when XENE_ENV=development.
#
# PURPOSE:
#   Enable development mode for local network testing (phone/tablet on same WiFi).
#   Allows ANY port on localhost and private IP ranges without needing exact ports.
#
# SETUP:
#   Just set XENE_ENV=development, that's it.
#   The CORS middleware will automatically allow:
#   - http://localhost:<any-port>
#   - http://127.0.0.1:<any-port>
#   - http://192.168.*:<any-port>
#   - http://10.*:<any-port>
#   - http://172.16-31.*:<any-port>
#
# DO NOT COMMIT:
#   This file is in .gitignore and is for your machine only.

XENE_ENV=development
